# sp_StatUpdate .gitignore
# WHITELIST APPROACH: Ignore everything, then allow only specific files
#
# Files published to GitHub (7 files, all at root):
#   - sp_StatUpdate.sql          (main procedure)
#   - sp_StatUpdate_Diag.sql     (diagnostic procedure)
#   - sp_StatUpdate_XE_Session.sql (Extended Events troubleshooting)
#   - Invoke-StatUpdateDiag.ps1  (multi-server diagnostic wrapper)
#   - README.md
#   - LICENSE

# Ignore everything by default
*

# Allow repo files at root
!sp_StatUpdate.sql
!sp_StatUpdate_Diag.sql
!sp_StatUpdate_XE_Session.sql
!Invoke-StatUpdateDiag.ps1
!README.md
!TESTING.md
!LICENSE
!.gitignore
!.gitattributes

# README demo screenshots (colorized terminal output, rendered to PNG)
!assets/
!assets/*.png

# CI: SQL comment size check
!.github/
!.github/workflows/
!.github/workflows/*.yml
!.github/scripts/
!.github/scripts/*.py
!.github/scripts/fixtures/
!.github/scripts/fixtures/*.sql

# Portable test suites are public; maintainer tooling stays local.
!tests/
!tests/**
tests-host/
tests/**/__pycache__/
tests/**/*.py[cod]
tests/**/*.log
tests/**/run-results.json
tests/**/suite-*.json
tests/**/results/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
